<ContentPage
    x:Class="JokerApp.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Maui;assembly=Microsoft.AspNetCore.Components.WebView.Maui"
    xmlns:local="clr-namespace:JokerApp.Pages">
    <!-- Upewnij się, że typ AppRoot istnieje w przestrzeni nazw JokerApp.Pages -->

    <blazor:BlazorWebView HostPage="wwwroot/index.html">
        <blazor:BlazorWebView.RootComponents>
            <!-- Jeśli AppRoot nie istnieje, utwórz go jako komponent Razor w JokerApp.Pages -->
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type local:AppRoot}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</ContentPage>